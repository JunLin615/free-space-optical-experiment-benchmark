{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline run manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "execution_class",
    "release_id",
    "selections",
    "protocol_ids",
    "agent",
    "runner_version",
    "system_prompt_version",
    "retrieval_config",
    "tool_config",
    "retry_policy",
    "timeout_seconds",
    "concurrency",
    "seed",
    "output_directory",
    "pricing_snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "execution_class": {
      "enum": [
        "real",
        "dry_run"
      ]
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "track",
          "variant_path"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^SEED-[1-8]-[1-8]$"
          },
          "track": {
            "enum": [
              "verified",
              "development",
              "public_variant",
              "private_variant"
            ]
          },
          "variant_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "protocol_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "closed_book",
          "case_assisted",
          "tool_assisted",
          "case_and_tool_assisted"
        ]
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_type",
        "provider",
        "model_id",
        "model_version",
        "framework",
        "scaffold_id",
        "command",
        "command_prefix",
        "mock_script"
      ],
      "properties": {
        "adapter_type": {
          "enum": [
            "mock",
            "command",
            "codex_cli"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "scaffold_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_prefix": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mock_script": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "runner_version": {
      "const": "0.1.0"
    },
    "system_prompt_version": {
      "const": "neutral_optics_v1"
    },
    "retrieval_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "tool_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "max_calls"
      ],
      "properties": {
        "profile_id": {
          "const": "generic_computation_v0.1"
        },
        "max_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_max_retries",
        "malformed_answer_max_retries",
        "self_correction_max_retries"
      ],
      "properties": {
        "transport_max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "malformed_answer_max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "self_correction_max_retries": {
          "const": 0
        }
      }
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600
    },
    "concurrency": {
      "const": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output_directory": {
      "type": "string",
      "minLength": 1
    },
    "pricing_snapshot": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
