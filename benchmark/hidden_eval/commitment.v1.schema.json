{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public-safe hidden bundle commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "benchmark_release_id", "generator_version", "hidden_policy_schema_version", "instance_count", "concept_family_count", "private_policy_sha256", "hidden_seed_sha256", "instance_commitments_sha256", "created_utc"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^HIDDEN-[0-9a-f]{16}$"},
    "benchmark_release_id": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "hidden_policy_schema_version": {"const": "1.0.0"},
    "instance_count": {"type": "integer", "minimum": 1},
    "concept_family_count": {"type": "integer", "minimum": 1},
    "private_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hidden_seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instance_commitments_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "created_utc": {"type": "string", "format": "date-time"}
  }
}
